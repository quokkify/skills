# Skill-improvement publishing harness — non-secret local config (per machine).
#
# install-harness.sh writes config.env from this template with the placeholders
# below filled in. This file stays on the machine and is never committed.
#
# Each machine MUST use a unique lane. Never point two machines at one branch.
#
# SKILL_HARNESS_REPO must match the worktree's origin URL exactly. publish_queue.py
# compares them as strings and fails closed when they differ, and GitHub's legacy
# redirect for a transferred or renamed repository does not satisfy that check.
SKILL_HARNESS_REPO="<owner/repository>"
SKILL_HARNESS_LANE="<unique-lowercase-device-lane>"
SKILL_HARNESS_WORKTREE="<absolute-path-to-lane-worktree>"
SKILL_HARNESS_MAIN="<absolute-path-to-stable-main-checkout>"

# Optional secondary hub (corporate, private, or a genuine fork). Leave unset to
# disable; `publish.sh --target secondary` then exits with an explanatory message.
#
# A secondary target needs its OWN lane and worktree: publish_queue.py requires the
# worktree origin to match the requested repository, so the secondary worktree must be
# a checkout whose origin points at that repository. It must also carry
# scripts/validate.sh, which the publisher runs before pushing.
# SKILL_HARNESS_SECONDARY_REPO="<owner/repository>"
# SKILL_HARNESS_SECONDARY_LANE="<unique-lowercase-device-lane>-sec"
# SKILL_HARNESS_SECONDARY_WORKTREE="<absolute-path-to-secondary-lane-worktree>"

# Minimum days between unattended skill_cycle.sh runs (async SessionStart hook).
SKILL_CYCLE_INTERVAL_DAYS=14
