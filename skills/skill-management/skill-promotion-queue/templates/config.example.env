# Skill-improvement publishing harness — non-secret local config (per machine).
#
# install-harness.sh writes config.env from this template with the placeholders
# below filled in. This file stays on the machine and is never committed.
#
# Each machine MUST use a unique lane. Never point two machines at one branch.
SKILL_HARNESS_REPO="<owner/repository>"
SKILL_HARNESS_LANE="<unique-lowercase-device-lane>"
SKILL_HARNESS_WORKTREE="<absolute-path-to-lane-worktree>"
SKILL_HARNESS_MAIN="<absolute-path-to-stable-main-checkout>"
