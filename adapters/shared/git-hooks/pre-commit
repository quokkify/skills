#!/usr/bin/env bash
set -euo pipefail

HOOK_NAME="pre-commit"

# A global core.hooksPath stops Git from running the repository's own hooks, so this hook hands
# over to the repository's hook of the same name once its own checks pass. `git rev-parse
# --git-path hooks` would return the global path; the common Git directory holds the
# repository's real hooks for linked worktrees, separate Git directories, and bare repositories.
# Resolved before any `cd` because the common directory may be reported relative to the cwd.
repository_hook_path() {
  local common_dir
  common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || return 0
  common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || return 0
  printf '%s/hooks/%s\n' "$common_dir" "$HOOK_NAME"
}
REPOSITORY_HOOK="$(repository_hook_path)"

run_shared_checks() {
  local git_root git_disable_file check_path
  git_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$git_root" ] || return 0

  case "${SKILLS_HUB_DISABLE_HOOKS:-0}:${SKILLS_HUB_DISABLE_GIT_HOOKS:-0}" in
    1:*|*:1) return 0 ;;
  esac
  case ",${SKILLS_HUB_SKIP_HOOKS:-},${SKILLS_HUB_SKIP_GIT_HOOKS:-}," in
    *,pre-commit,*|*,git-pre-commit,*) return 0 ;;
  esac
  git_disable_file="$(git -C "$git_root" rev-parse --git-path skills-hooks-disable 2>/dev/null || true)"
  if [ -f "$git_root/.skills-hooks-disable" ] || { [ -n "$git_disable_file" ] && [ -f "$git_disable_file" ]; }; then
    return 0
  fi

  git -C "$git_root" diff --cached --check --diff-filter=ACMR --

  check_path="$(git -C "$git_root" config --path --get skills-hub.check.pre-commit 2>/dev/null || true)"
  [ -z "$check_path" ] && return 0
  case "$check_path" in
    /*) ;;
    *) check_path="$git_root/$check_path" ;;
  esac
  [ -x "$check_path" ] || return 0
  (cd "$git_root" && "$check_path")
}

# The shared checks run first so that nothing the repository hook does can skip them. Opting out
# of the shared checks never skips the repository's own hook.
run_shared_checks "$@"

if [ -n "$REPOSITORY_HOOK" ] && [ -f "$REPOSITORY_HOOK" ] && [ -x "$REPOSITORY_HOOK" ] &&
  ! [ "$REPOSITORY_HOOK" -ef "${BASH_SOURCE[0]}" ]; then
  exec "$REPOSITORY_HOOK" "$@"
fi
