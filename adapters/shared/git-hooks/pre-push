#!/usr/bin/env bash
set -euo pipefail

HOOK_NAME="pre-push"

# A global core.hooksPath stops Git from running the repository's own hooks, so this hook hands
# over to the repository's hook of the same name once its own checks pass. `git rev-parse
# --git-path hooks` would return the global path; the common Git directory holds the
# repository's real hooks for linked worktrees, separate Git directories, and bare repositories.
# Resolved before any `cd` because the common directory may be reported relative to the cwd.
repository_hook_path() {
  local common_dir
  common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || return 0
  common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || return 0
  printf '%s/hooks/%s\n' "$common_dir" "$HOOK_NAME"
}
REPOSITORY_HOOK="$(repository_hook_path)"

# Git writes the pushed refs to stdin once; keep them so the repository hook receives them too.
PUSH_REFS="$(mktemp "${TMPDIR:-/tmp}/skills-hub-pre-push.XXXXXX")"
trap 'rm -f "$PUSH_REFS"' EXIT
cat > "$PUSH_REFS"

run_shared_checks() {
  local git_root git_disable_file check_path
  git_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$git_root" ] || return 0

  case "${SKILLS_HUB_DISABLE_HOOKS:-0}:${SKILLS_HUB_DISABLE_GIT_HOOKS:-0}" in
    1:*|*:1) return 0 ;;
  esac
  case ",${SKILLS_HUB_SKIP_HOOKS:-},${SKILLS_HUB_SKIP_GIT_HOOKS:-}," in
    *,pre-push,*|*,git-pre-push,*) return 0 ;;
  esac
  git_disable_file="$(git -C "$git_root" rev-parse --git-path skills-hooks-disable 2>/dev/null || true)"
  if [ -f "$git_root/.skills-hooks-disable" ] || { [ -n "$git_disable_file" ] && [ -f "$git_disable_file" ]; }; then
    return 0
  fi

  local local_ref local_oid remote_ref remote_oid remote_tip commit_oid new_commits
  local -a remote_tips revision_args
  while read -r local_ref local_oid remote_ref remote_oid; do
    [ -n "${local_oid:-}" ] || continue
    case "$local_oid" in
      0000000000000000000000000000000000000000) continue ;;
    esac
    case "${remote_oid:-}" in
      0000000000000000000000000000000000000000)
        if [ -z "${2:-}" ]; then
          printf '%s\n' "Cannot validate a new pushed ref without a remote URL." >&2
          exit 1
        fi
        # A new remote ref has no remote_oid to use as the revision boundary.
        # Avoid enumerating every server ref; use locally cached remote-tracking refs.
        remote_tips=()
        while read -r remote_tip; do
          [ -n "${remote_tip:-}" ] || continue
          if git -C "$git_root" cat-file -e "$remote_tip^{commit}" 2>/dev/null; then
            remote_tips+=("$remote_tip")
          fi
        done < <(git -C "$git_root" for-each-ref --format="%(objectname)" refs/remotes/)
        revision_args=("$local_oid")
        if [ "${#remote_tips[@]}" -gt 0 ]; then
          revision_args+=(--not "${remote_tips[@]}")
        fi
        ;;
      *)
        revision_args=("$local_oid" "^$remote_oid")
        ;;
    esac
    new_commits="$(git -C "$git_root" rev-list "${revision_args[@]}")"
    while IFS= read -r commit_oid; do
      [ -n "$commit_oid" ] || continue
      git -C "$git_root" diff-tree --check --no-commit-id --root -r -m --diff-filter=ACMR "$commit_oid" --
    done <<< "$new_commits"
  done < "$PUSH_REFS"

  check_path="$(git -C "$git_root" config --path --get skills-hub.check.pre-push 2>/dev/null || true)"
  [ -z "$check_path" ] && return 0
  case "$check_path" in
    /*) ;;
    *) check_path="$git_root/$check_path" ;;
  esac
  [ -x "$check_path" ] || return 0
  (cd "$git_root" && "$check_path")
}

# The shared checks run first so that nothing the repository hook does can skip them. Opting out
# of the shared checks never skips the repository's own hook.
run_shared_checks "$@"

if [ -n "$REPOSITORY_HOOK" ] && [ -f "$REPOSITORY_HOOK" ] && [ -x "$REPOSITORY_HOOK" ] &&
  ! [ "$REPOSITORY_HOOK" -ef "${BASH_SOURCE[0]}" ]; then
  status=0
  "$REPOSITORY_HOOK" "$@" < "$PUSH_REFS" || status=$?
  exit "$status"
fi
